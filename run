#!/usr/bin/env bash
# filem8: build (release, low priority) and open the window. Arguments go to filem8 (e.g. `run --get-icons`).
# Light build by default (window + images). FM8_FULL=1 adds SVG, audio, glTF, archives.
# Other knobs: FM8_BACKEND=vulkan|gl|soft  FM8_SCALE=1.5
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"
if [ "${FM8_FULL:-0}" = 1 ]; then
  nice -n 19 cargo build --release -p filem8 --features full
else
  nice -n 19 cargo build --release -p filem8
fi
exec ./target/release/filem8 "$@"
